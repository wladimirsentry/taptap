<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="tocamatik_bg">#F5F4FA</color>
    <color name="tocamatik_primary">#5B47F5</color>
    <color name="tocamatik_ink">#17152B</color>

    <style name="Theme.Tocamatik" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/tocamatik_bg</item>
        <item name="android:colorPrimary">@color/tocamatik_primary</item>
        <item name="android:colorAccent">@color/tocamatik_primary</item>
        <item name="android:colorControlActivated">@color/tocamatik_primary</item>
        <item name="android:textColorPrimary">@color/tocamatik_ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
